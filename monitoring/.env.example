# Variables requeridas por monitoring/docker-compose.yml (Grafana).
# Copiar a ".env" y completar antes de correr "docker compose up -d" localmente.
# En CI/CD, estos valores se inyectan desde GitHub Secrets (GRAFANA_ADMIN_USER / GRAFANA_ADMIN_PASSWORD),
# no desde este archivo.

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar-por-una-password-real
